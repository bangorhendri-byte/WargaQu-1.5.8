                                        <div id="node-${grandChild.id}" class="pcb-node bg-slate-950 border border-emerald-900/60 rounded p-2 text-center min-w-[100px] text-[10px] hover:border-emerald-500 transition">
                                            ${showPhoto ? `<img src="${grandChild.photo}" class="w-7 h-7 rounded-full mx-auto mb-1 object-cover">` : ''}
                                            <div class="font-semibold text-slate-300 truncate">${grandChild.name}</div>
