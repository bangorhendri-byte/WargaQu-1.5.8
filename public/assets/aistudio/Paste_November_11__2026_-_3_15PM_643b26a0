<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modul Silsilah Trah Keluarga - Multi-Skin & PCB Print Engine</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Fira+Code:wght@400;500;600&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eefbf6',
                            100: '#d7f7e9',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                            900: '#064e3b',
                        },
                        pcb: {
                            board: '#0B1D16',
                            trace: '#10B981',
                            pad: '#F59E0B',
                            chip: '#1E293B',
                            text: '#34D399'
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        mono: ['Fira Code', 'monospace']
                    }
                }
            }
        }
    </script>

    <style>
        /* CSS Khusus & Canvas Printing */
        body {
            background-color: #0F172A;
            color: #F8FAFC;
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
        }

        /* Simulasi Kertas Cetak */
        .paper-sheet {
            background-color: #ffffff;
            color: #0f172a;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        /* Preset Ukuran Kertas Landscape & Portrait (Dalam Rasio mm) */
        .paper-a4-landscape { width: 297mm; min-height: 210mm; }
        .paper-a4-portrait  { width: 210mm; min-height: 297mm; }

        .paper-a3-landscape { width: 420mm; min-height: 297mm; }
        .paper-a3-portrait  { width: 297mm; min-height: 420mm; }

        .paper-a2-landscape { width: 594mm; min-height: 420mm; }
        .paper-a2-portrait  { width: 420mm; min-height: 594mm; }

        .paper-a1-landscape { width: 841mm; min-height: 594mm; }
        .paper-a1-portrait  { width: 594mm; min-height: 841mm; }

        .paper-a0-landscape { width: 1189mm; min-height: 841mm; }
        .paper-a0-portrait  { width: 841mm; min-height: 1189mm; }

        .paper-f4-landscape { width: 330mm; min-height: 215mm; }
        .paper-banner       { width: 450mm; min-height: 250mm; }

        /* Pattern Grid Kertas Preview */
        .bg-grid-pattern {
            background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
            background-size: 16px 16px;
        }

        /* Pattern Board PCB */
        .bg-pcb-pattern {
            background-color: #081410;
            background-image: 
                linear-gradient(rgba(16, 185, 129, 0.1) 1px, transparent 1px),
                linear-gradient(90deg, rgba(16, 185, 129, 0.1) 1px, transparent 1px);
            background-size: 20px 20px;
        }

        /* Routing Lines SVG Canvas */
        .svg-routing-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 10;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #1e293b;
        }
        ::-webkit-scrollbar-thumb {
            background: #475569;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }

        /* CSS Print Overrides */
        @media print {
            @page {
                size: landscape;
                margin: 0;
            }
            body {
                background: #ffffff !important;
                color: #000000 !important;
                padding: 0 !important;
                margin: 0 !important;
            }
            .no-print {
                display: none !important;
            }
            .print-area-wrapper {
                padding: 0 !important;
                margin: 0 !important;
                overflow: visible !important;
                transform: scale(1) !important;
            }
            .paper-sheet {
                box-shadow: none !important;
                margin: 0 !important;
                width: 100% !important;
                height: 100% !important;
                border: none !important;
            }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- TOP NAVIGATION BAR (NO PRINT) -->
    <header class="no-print bg-slate-900 border-b border-slate-800 sticky top-0 z-50 px-4 py-3 shadow-lg">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4">
            
            <!-- Branding -->
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-emerald-400 flex items-center justify-center text-white shadow-lg shadow-brand-500/20">
                    <i class="fa-solid fa-diagram-project text-lg"></i>
                </div>
                <div>
                    <h1 class="font-bold text-base md:text-lg text-white leading-tight flex items-center gap-2">
                        Trah Ibu Arunti <span class="bg-brand-500/20 text-brand-400 text-xs px-2 py-0.5 rounded-full font-mono border border-brand-500/30">v2.5 PCB Engine</span>
                    </h1>
                    <p class="text-xs text-slate-400">Modul Silsilah Multi-Skin & Layout Auto-Fit Cetak</p>
                </div>
            </div>

            <!-- Global Action Controls -->
            <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
                <!-- Scale indicator & Fit Page -->
                <div class="bg-slate-800 border border-slate-700 rounded-lg p-1 flex items-center gap-2">
                    <button onclick="changeZoom(-0.05)" class="w-7 h-7 rounded bg-slate-700 hover:bg-slate-600 flex items-center justify-center text-xs text-slate-200 transition" title="Zoom Out">
                        <i class="fa-solid fa-minus"></i>
                    </button>
                    <span id="zoomLabel" class="text-xs font-mono w-12 text-center text-emerald-400 font-bold">100%</span>
                    <button onclick="changeZoom(0.05)" class="w-7 h-7 rounded bg-slate-700 hover:bg-slate-600 flex items-center justify-center text-xs text-slate-200 transition" title="Zoom In">
                        <i class="fa-solid fa-plus"></i>
                    </button>
                    <button onclick="autoFitToPaper()" class="px-2 py-1 bg-brand-600/30 hover:bg-brand-600/50 text-brand-300 text-xs font-medium rounded border border-brand-500/30 flex items-center gap-1 transition">
                        <i class="fa-solid fa-expand text-[10px]"></i> Pas Kertas
                    </button>
                </div>

                <!-- Print Button -->
                <button onclick="triggerPrint()" class="bg-gradient-to-r from-brand-600 to-emerald-500 hover:from-brand-500 hover:to-emerald-400 text-white font-semibold text-xs md:text-sm px-4 py-2 rounded-lg shadow-md shadow-brand-600/30 flex items-center gap-2 transition transform active:scale-95">
                    <i class="fa-solid fa-print"></i>
                    <span>Cetak Silsilah</span>
                </button>
            </div>
        </div>
    </header>

    <!-- CONTROL PANEL TOOLBAR (NO PRINT) -->
    <div class="no-print bg-slate-900/90 border-b border-slate-800 backdrop-blur px-4 py-2.5">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3 text-xs">
            
            <!-- Skin Selector Tabs -->
            <div class="flex items-center gap-1 bg-slate-950 p-1 rounded-xl border border-slate-800 overflow-x-auto max-w-full">
                <span class="text-slate-400 px-2 font-medium flex items-center gap-1.5 hidden md:flex">
                    <i class="fa-solid fa-palette text-slate-500"></i> Skin Layout:
                </span>
                
                <button onclick="setSkin('pcb')" id="btn-skin-pcb" class="skin-tab px-3 py-1.5 rounded-lg font-medium flex items-center gap-1.5 transition text-emerald-400 bg-slate-800 border border-slate-700 shadow-sm">
                    <i class="fa-solid fa-microchip"></i>
                    <span>1. PCB Auto-Router</span>
                </button>
                
                <button onclick="setSkin('compact')" id="btn-skin-compact" class="skin-tab px-3 py-1.5 rounded-lg font-medium flex items-center gap-1.5 transition text-slate-400 hover:text-white hover:bg-slate-800/50">
                    <i class="fa-solid fa-id-badge"></i>
                    <span>2. Compact Badge</span>
                </button>
                
                <button onclick="setSkin('stack')" id="btn-skin-stack" class="skin-tab px-3 py-1.5 rounded-lg font-medium flex items-center gap-1.5 transition text-slate-400 hover:text-white hover:bg-slate-800/50">
                    <i class="fa-solid fa-layer-group"></i>
                    <span>3. Vertical Stack</span>
                </button>
                
                <button onclick="setSkin('radial')" id="btn-skin-radial" class="skin-tab px-3 py-1.5 rounded-lg font-medium flex items-center gap-1.5 transition text-slate-400 hover:text-white hover:bg-slate-800/50">
                    <i class="fa-solid fa-circle-nodes"></i>
                    <span>4. Radial Wheel</span>
                </button>
            </div>

            <!-- Paper Size & View Controls -->
            <div class="flex items-center gap-3 flex-wrap">
                <!-- Size Paper Selector (A0 - A4) -->
                <div class="flex items-center gap-1.5 bg-slate-950 px-2 py-1 rounded-lg border border-slate-800">
                    <i class="fa-solid fa-file-lines text-emerald-400"></i>
                    <span class="text-slate-400 font-medium">Ukuran Kertas:</span>
                    <select id="paperSizeSelect" onchange="changePaperSize(this.value)" class="bg-slate-800 text-emerald-300 font-mono text-xs rounded px-2 py-1 border border-slate-700 outline-none cursor-pointer font-semibold">
                        <optgroup label="Standar ISO (A4 - A0)">
                            <option value="a4-landscape" selected>A4 Landscape (297 x 210 mm)</option>
                            <option value="a4-portrait">A4 Portrait (210 x 297 mm)</option>
                            <option value="a3-landscape">A3 Landscape (420 x 297 mm)</option>
                            <option value="a3-portrait">A3 Portrait (297 x 420 mm)</option>
                            <option value="a2-landscape">A2 Landscape (594 x 420 mm)</option>
                            <option value="a2-portrait">A2 Portrait (420 x 594 mm)</option>
                            <option value="a1-landscape">A1 Plotter (841 x 594 mm)</option>
                            <option value="a1-portrait">A1 Portrait (594 x 841 mm)</option>
                            <option value="a0-landscape">A0 Jumbo Plotter (1189 x 841 mm)</option>
                            <option value="a0-portrait">A0 Portrait (841 x 1189 mm)</option>
                        </optgroup>
                        <optgroup label="Lainnya">
                            <option value="f4-landscape">F4 / Folio Landscape (330 x 215 mm)</option>
                            <option value="banner">Spanduk / Mini Banner (450 x 250 mm)</option>
                        </optgroup>
                    </select>
                </div>

                <!-- Display Mode Option -->
                <div class="flex items-center gap-1.5 bg-slate-950 px-2 py-1 rounded-lg border border-slate-800">
                    <input type="checkbox" id="chkShowPhotos" checked onchange="renderSilsilah()" class="accent-brand-500 rounded cursor-pointer">
                    <label for="chkShowPhotos" class="text-slate-300 font-medium cursor-pointer select-none">Tampilkan Foto Avatar</label>
                </div>
            </div>

        </div>
    </div>

    <!-- MAIN PREVIEW CANVAS AREA -->
    <main class="flex-1 bg-slate-950 p-4 md:p-8 overflow-auto flex items-start justify-center print-area-wrapper">
        
        <!-- Interactive Paper Container -->
        <div id="paperSheet" class="paper-sheet paper-a4-landscape rounded-lg border border-slate-700 transition-all duration-300 overflow-hidden relative">
            
            <!-- Header Paper Cetak (Watermark/Title Cetak) -->
            <div id="paperHeader" class="p-6 pb-2 border-b border-slate-200 flex justify-between items-start bg-slate-50/50">
                <div>
                    <h2 class="text-xl font-bold text-slate-800 tracking-tight flex items-center gap-2">
                        <span>SILSILAH TRAH IBU ARUNTI</span>
                        <span id="badgeSkinTitle" class="text-xs bg-slate-200 text-slate-700 font-mono px-2 py-0.5 rounded uppercase">Mode PCB Auto-Router</span>
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">Dokumen Resmi Registri Keluarga - Generasi I s.d. Generasi III (55 Anggota Registered)</p>
                </div>
                <div class="text-right text-[10px] text-slate-400 font-mono">
                    <p>Cetak Tanggal: 10 Nov 2026</p>
                    <p>Format: Lanskap Auto-Fit</p>
                </div>
            </div>

            <!-- Content Area Silsilah -->
            <div id="treeContainer" class="p-6 relative min-h-[550px] flex items-center justify-center bg-grid-pattern">
                
                <!-- SVG Layer for Dynamic 90-degree Orthogonal PCB Traces -->
                <svg id="svgRoutes" class="svg-routing-layer"></svg>

                <!-- Dynamic Tree Nodes Inject Here -->
                <div id="treeNodesWrapper" class="w-full relative z-20"></div>

            </div>

            <!-- Footer Paper Cetak -->
            <div class="px-6 py-3 border-t border-slate-200 bg-slate-50/80 flex justify-between items-center text-[11px] text-slate-500">
                <span><i class="fa-solid fa-shield-halved text-brand-600"></i> Trah Ibu Arunti &copy; 2026 - Jalur Koneksi Otomatis Anti-Terpotong</span>
                <span class="font-mono">Halaman 1 dari 1 (Pas Kertas)</span>
            </div>

        </div>

    </main>

    <!-- FOOTER PANEL INFORMASI (NO PRINT) -->
    <footer class="no-print bg-slate-900 border-t border-slate-800 px-4 py-3 text-xs text-slate-400">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <span class="flex items-center gap-1 text-emerald-400"><i class="fa-solid fa-circle-check"></i> Status System: Optimal</span>
                <span class="flex items-center gap-1"><i class="fa-solid fa-route"></i> PCB Auto-Routing: 4-Directional Pin Avoidance</span>
            </div>
            <div class="text-slate-500">
                Petunjuk: Gunakan fitur <b class="text-slate-300">Pas Kertas</b> jika silsilah melebar keluar dari garis batas kertas cetak.
            </div>
        </div>
    </footer>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Mock Data Silsilah Trah Ibu Arunti
        const familyData = {
            id: 'root',
            name: 'Ibu Arunti',
            title: 'Leluhur Utama (Generasi 1)',
            photo: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=150&auto=format&fit=crop&q=80',
            gender: 'F',
            spouse: 'Bapak Trah',
            children: [
                {
                    id: 'c1',
                    name: 'Trah Santa (G2)',
                    title: 'Anak Ke-1 (55 Anggota)',
                    photo: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&auto=format&fit=crop&q=80',
                    gender: 'M',
                    spouse: 'Ibu Mary',
                    children: [
                        { id: 'c1_1', name: 'Budi Santoso', title: 'Cucu 1', gender: 'M', photo: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=150&auto=format&fit=crop&q=80' },
                        { id: 'c1_2', name: 'Siti Rahma', title: 'Cucu 2', gender: 'F', photo: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=150&auto=format&fit=crop&q=80' },
                        { id: 'c1_3', name: 'Agus Pratama', title: 'Cucu 3', gender: 'M', photo: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=150&auto=format&fit=crop&q=80' },
                        { id: 'c1_4', name: 'Dewi Lestari', title: 'Cucu 4', gender: 'F', photo: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80' }
                    ]
                },
                {
                    id: 'c2',
                    name: 'Trah Ayah (G2)',
                    title: 'Anak Ke-2',
                    photo: 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=150&auto=format&fit=crop&q=80',
                    gender: 'M',
                    spouse: 'Ibu Annisa',
                    children: [
                        { id: 'c2_1', name: 'Eko Wijaya', title: 'Cucu 5', gender: 'M', photo: 'https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?w=150&auto=format&fit=crop&q=80' },
                        { id: 'c2_2', name: 'Rina Astuti', title: 'Cucu 6', gender: 'F', photo: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=150&auto=format&fit=crop&q=80' }
                    ]
                },
                {
                    id: 'c3',
                    name: 'Trah Ibu (G2)',
                    title: 'Anak Ke-3',
                    photo: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=150&auto=format&fit=crop&q=80',
                    gender: 'F',
                    spouse: 'Bapak Hartono',
                    children: [
                        { id: 'c3_1', name: 'Fajar Nugraha', title: 'Cucu 7', gender: 'M', photo: 'https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=150&auto=format&fit=crop&q=80' },
                        { id: 'c3_2', name: 'Gita Gutawa', title: 'Cucu 8', gender: 'F', photo: 'https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=150&auto=format&fit=crop&q=80' },
                        { id: 'c3_3', name: 'Hadi Kurnia', title: 'Cucu 9', gender: 'M', photo: 'https://images.unsplash.com/photo-1522075469751-3a6694fb2f61?w=150&auto=format&fit=crop&q=80' }
                    ]
                }
            ]
        };

        // Application State
        let currentSkin = 'pcb';
        let currentZoom = 1.0;
        let paperSize = 'a4-landscape';

        // Initialize on Window Load
        window.onload = function() {
            renderSilsilah();
            window.addEventListener('resize', () => {
                autoFitToPaper();
                if(currentSkin === 'pcb') drawPCBRoutes();
            });
        };

        // Zoom & Auto-Scale Logic
        function changeZoom(delta) {
            currentZoom = Math.max(0.15, Math.min(2.0, currentZoom + delta));
            updateZoomTransform();
        }

        function updateZoomTransform() {
            const paper = document.getElementById('paperSheet');
            paper.style.transform = `scale(${currentZoom})`;
            document.getElementById('zoomLabel').innerText = `${Math.round(currentZoom * 100)}%`;
        }

        function autoFitToPaper() {
            const wrapper = document.querySelector('.print-area-wrapper');
            const paper = document.getElementById('paperSheet');
            
            // Calculate scale ratio to fit available screen width & height
            const availableWidth = wrapper.clientWidth - 48;
            const paperWidth = paper.offsetWidth;
            
            if (paperWidth > 0) {
                currentZoom = Math.min(1.2, availableWidth / paperWidth);
                currentZoom = Math.max(0.15, currentZoom);
            }
            updateZoomTransform();
        }

        function changePaperSize(sizeKey) {
            paperSize = sizeKey;
            const paper = document.getElementById('paperSheet');
            
            // Reset paper size classes
            paper.className = 'paper-sheet rounded-lg border border-slate-700 transition-all duration-300 overflow-hidden relative ';
            paper.classList.add(`paper-${sizeKey}`);

            // Update Dynamic Dynamic Dynamic Dynamic CSS Print Page Size Rule
            updatePrintStyleSheet(sizeKey);

            setTimeout(() => {
                renderSilsilah();
                autoFitToPaper();
            }, 100);
        }

        // Dynamically Update @page Rule for Print Engine
        function updatePrintStyleSheet(sizeKey) {
            let styleElem = document.getElementById('dynamicPrintStyle');
            if (!styleElem) {
                styleElem = document.createElement('style');
                styleElem.id = 'dynamicPrintStyle';
                document.head.appendChild(styleElem);
            }

            const sizeParts = sizeKey.split('-');
            const paperName = sizeParts[0].toUpperCase();
            const orientation = sizeParts[1] || 'landscape';

            styleElem.innerHTML = `
                @media print {
                    @page {
                        size: ${paperName !== 'BANNER' && paperName !== 'F4' ? paperName : 'A4'} ${orientation};
                        margin: 0;
                    }
                }
            `;
        }

        function setSkin(skin) {
            currentSkin = skin;
            
            // Update Tab Active States
            document.querySelectorAll('.skin-tab').forEach(btn => {
                btn.className = 'skin-tab px-3 py-1.5 rounded-lg font-medium flex items-center gap-1.5 transition text-slate-400 hover:text-white hover:bg-slate-800/50';
            });
            
            const activeBtn = document.getElementById(`btn-skin-${skin}`);
            activeBtn.className = 'skin-tab px-3 py-1.5 rounded-lg font-medium flex items-center gap-1.5 transition text-emerald-400 bg-slate-800 border border-slate-700 shadow-sm';

            // Update Badge Title
            const titles = {
                pcb: 'Mode PCB Auto-Router (90° Routing)',
                compact: 'Mode Compact Badge (Hemat Ruang)',
                stack: 'Mode Vertical Stack Grid',
                radial: 'Mode Radial Wheel'
            };
            document.getElementById('badgeSkinTitle').innerText = titles[skin];

            // Adjust Container Styling
            const treeContainer = document.getElementById('treeContainer');
            if(skin === 'pcb') {
                treeContainer.className = 'p-6 relative min-h-[550px] flex items-center justify-center bg-pcb-pattern text-white rounded-b';
            } else {
                treeContainer.className = 'p-6 relative min-h-[550px] flex items-center justify-center bg-grid-pattern text-slate-800';
            }

            renderSilsilah();
        }

        // Render Routing Engine router Switcher
        function renderSilsilah() {
            const wrapper = document.getElementById('treeNodesWrapper');
            const svgLayer = document.getElementById('svgRoutes');
            svgLayer.innerHTML = ''; // clear SVG lines
            wrapper.innerHTML = '';

            if (currentSkin === 'pcb') {
                renderPCBSkin(wrapper);
                setTimeout(drawPCBRoutes, 50);
            } else if (currentSkin === 'compact') {
                renderCompactSkin(wrapper);
            } else if (currentSkin === 'stack') {
                renderStackSkin(wrapper);
            } else if (currentSkin === 'radial') {
                renderRadialSkin(wrapper);
            }
        }

        /* -------------------------------------------------------------
           SKIN 1: PCB AUTO-ROUTER (Nodes with 4-Directional Traces)
        ---------------------------------------------------------------- */
        function renderPCBSkin(container) {
            const showPhoto = document.getElementById('chkShowPhotos').checked;
            
            let html = `
                <div class="flex flex-col items-center gap-12 font-mono">
                    <!-- Root Node (IC Core) -->
                    <div id="node-root" class="pcb-node bg-slate-900 border-2 border-emerald-500 rounded-lg p-3 shadow-lg shadow-emerald-500/20 text-center relative z-20 min-w-[200px]">
                        <div class="absolute -top-2 left-1/2 -translate-x-1/2 bg-emerald-500 text-slate-950 font-bold text-[9px] px-2 py-0.2 rounded-full uppercase">IC-ROOT (G1)</div>
                        ${showPhoto ? `<img src="${familyData.photo}" class="w-12 h-12 rounded-full border-2 border-emerald-400 mx-auto my-1 object-cover" onerror="this.src='https://placehold.co/100/10b981/ffffff?text=Arunti'">` : ''}
                        <h3 class="font-bold text-sm text-emerald-300">${familyData.name}</h3>
                        <p class="text-[10px] text-slate-400">${familyData.spouse ? '& ' + familyData.spouse : ''}</p>
                    </div>

                    <!-- Level 2 Children (Sub Chips) -->
                    <div class="flex flex-wrap justify-center gap-12 relative z-20 w-full">
                        ${familyData.children.map((child, idx) => `
                            <div class="flex flex-col items-center gap-8">
                                <div id="node-${child.id}" class="pcb-node bg-slate-900 border border-slate-700 hover:border-emerald-400 rounded-lg p-3 text-center min-w-[170px] shadow-md relative">
