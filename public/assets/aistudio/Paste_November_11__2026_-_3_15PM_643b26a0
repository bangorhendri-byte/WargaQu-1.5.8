        /* -------------------------------------------------------------
           SKIN 4: RADIAL WHEEL (Circular Layout)
        ---------------------------------------------------------------- */
        function renderRadialSkin(container) {
            const showPhoto = document.getElementById('chkShowPhotos').checked;

            let html = `
                <div class="relative w-[450px] h-[450px] mx-auto flex items-center justify-center">
                    <!-- Center Hub -->
                    <div class="absolute z-30 bg-brand-600 text-white rounded-full w-24 h-24 flex flex-col items-center justify-center text-center p-2 shadow-xl border-4 border-white">
                        ${showPhoto ? `<img src="${familyData.photo}" class="w-8 h-8 rounded-full border border-white mb-0.5 object-cover">` : ''}
                        <span class="font-bold text-[10px] leading-tight">${familyData.name}</span>
                    </div>

                    <!-- Outer Ring 1 (Children) -->
                    <div class="absolute w-[260px] h-[260px] rounded-full border-2 border-dashed border-slate-300 flex items-center justify-center">
                        ${familyData.children.map((child, idx) => {
                            const angle = (idx / familyData.children.length) * 360;
                            const x = Math.cos((angle * Math.PI) / 180) * 130;
                            const y = Math.sin((angle * Math.PI) / 180) * 130;
                            return `
                                <div style="transform: translate(${x}px, ${y}px);" class="absolute z-20 bg-white border border-slate-300 rounded-full px-3 py-1 text-center shadow-md flex items-center gap-1">
                                    ${showPhoto ? `<img src="${child.photo}" class="w-5 h-5 rounded-full object-cover">` : ''}
                                    <span class="text-[10px] font-bold text-slate-700">${child.name}</span>
                                </div>
                            `;
                        }).join('')}
                    </div>

                    <!-- Outer Ring 2 (Grandchildren Decorative Orbit) -->
                    <div class="absolute w-[420px] h-[420px] rounded-full border border-slate-200"></div>
                </div>
            `;
            container.innerHTML = html;
        }

        // Trigger Standard Browser Print Dialog
        function triggerPrint() {
            // Ensure full paper visibility before printing
            const originalZoom = currentZoom;
            currentZoom = 1.0;
            updateZoomTransform();

            setTimeout(() => {
                window.print();
                currentZoom = originalZoom;
                updateZoomTransform();
            }, 200);
        }
    </script>
