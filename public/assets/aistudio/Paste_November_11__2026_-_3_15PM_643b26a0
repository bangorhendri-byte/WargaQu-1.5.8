        }

        // PCB 90-Degree Orthogonal Line Drawing Logic
        function drawPCBRoutes() {
            const svg = document.getElementById('svgRoutes');
            const containerRect = document.getElementById('treeContainer').getBoundingClientRect();
            svg.innerHTML = '';

            function getCenterPin(elId, position = 'bottom') {
                const el = document.getElementById(elId);
                if (!el) return { x: 0, y: 0 };
                const rect = el.getBoundingClientRect();
                
                let x = rect.left + rect.width / 2 - containerRect.left;
                let y = rect.top + rect.height / 2 - containerRect.top;

                if (position === 'top') y = rect.top - containerRect.top;
                if (position === 'bottom') y = rect.bottom - containerRect.top;
                if (position === 'left') x = rect.left - containerRect.left;
                if (position === 'right') x = rect.right - containerRect.left;

                return { x, y };
            }

            function createOrthogonalPath(p1, p2) {
                const midY = p1.y + (p2.y - p1.y) / 2;
                // 90 degree orthogonal routing (PCB Style)
                return `M ${p1.x} ${p1.y} L ${p1.x} ${midY} L ${p2.x} ${midY} L ${p2.x} ${p2.y}`;
            }

            const rootPin = getCenterPin('node-root', 'bottom');

            // Draw to Children
            familyData.children.forEach(child => {
                const childPinTop = getCenterPin(`node-${child.id}`, 'top');
                const pathStr = createOrthogonalPath(rootPin, childPinTop);
                
                // Draw Trace Path
                const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                path.setAttribute('d', pathStr);
                path.setAttribute('stroke', '#10B981');
                path.setAttribute('stroke-width', '2');
                path.setAttribute('fill', 'none');
                path.setAttribute('stroke-linejoin', 'round');
                svg.appendChild(path);

                // Draw Pad Points
                const childPinBottom = getCenterPin(`node-${child.id}`, 'bottom');
                child.children.forEach(grandChild => {
                    const gPinTop = getCenterPin(`node-${grandChild.id}`, 'top');
                    const gPathStr = createOrthogonalPath(childPinBottom, gPinTop);

                    const gPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                    gPath.setAttribute('d', gPathStr);
                    gPath.setAttribute('stroke', '#059669');
                    gPath.setAttribute('stroke-width', '1.5');
                    gPath.setAttribute('stroke-dasharray', '3,3');
                    gPath.setAttribute('fill', 'none');
                    svg.appendChild(gPath);
                });
            });
        }

